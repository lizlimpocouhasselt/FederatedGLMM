# Load the glpkAPI package
library(glpkAPI)
# --- Problem Data ---
# Number of constraints (rows)
num_rows <- 3
# Number of variables (columns)
num_cols <- 2
# Objective function coefficients (for maximization)
obj_coefs <- c(3, 5)
# Constraint matrix A (rows by columns)
A <- matrix(c(
1, 0,
0, 2,
3, 2
), nrow = num_rows, byrow = TRUE)
# Right-hand side (RHS) values
rhs <- c(4, 12, 18)
# Constraint types: GLP_UP means <= (Upper bound)
# Other types include GLP_FX (fixed/equality), GLP_LO (lower bound/ >=)
row_types <- rep(GLP_UP, num_rows)
# Initialize the GLPK problem object
lp <- initProbGLPK()
# Set the optimization direction (GLP_MAX for maximization)
setObjDirGLPK(lp, GLP_MAX)
# Set the problem name
setProbNameGLPK(lp, "InteriorPointLPExample")
# Add rows (constraints)
addRowsGLPK(lp, num_rows)
# Set row bounds (constraint limits)
for (i in 1:num_rows) {
setRowBndGLPK(lp, i, row_types[i], 0, rhs[i])
}
# Add columns (variables)
addColsGLPK(lp, num_cols)
# Set column bounds and objective coefficients
for (j in 1:num_cols) {
# Variables are non-negative (lower bound 0, upper bound infinite/GLP_FR)
setColBndGLPK(lp, j, GLP_LO, 0, 0)
# Set objective coefficients
setObjCoefGLPK(lp, j, obj_coefs[j])
}
# Add the constraint matrix entries
# The glpkAPI requires sparse matrix format for input: (i, j, value) triplets
# We extract the non-zero elements
A_nz_indices <- which(A != 0, arr.ind = TRUE)
ne <- nrow(A_nz_indices) # Number of non-zero elements
ia <- A_nz_indices[, "row"] # Row indices
ja <- A_nz_indices[, "col"] # Column indices
ar <- A[A_nz_indices]       # Values
# Load the matrix data
loadMatrixGLPK(lp, ne, ia, ja, ar)
# --- Solve the problem using the Interior-Point Method ---
solve_status <- solveInteriorGLPK(lp)
# --- Check the solution status and retrieve results ---
if (solve_status == 0) { # 0 indicates success
# Retrieve the optimal objective value from the IP solution
optimal_value <- getObjValIptGLPK(lp)
# Retrieve the primal solution (variable values)
x_values <- getColsPrimIptGLPK(lp)
# Retrieve the dual solution (shadow prices for constraints)
y_values <- getRowsDualIptGLPK(lp)
cat("✨ Solution found using Interior-Point Method (GLPK) ✨\n")
cat("----------------------------------------------------------\n")
cat(sprintf("Optimal Objective Value (Z): %.4f\n", optimal_value))
cat(sprintf("Optimal Variable Values: x1 = %.4f, x2 = %.4f\n", x_values[1], x_values[2]))
cat(sprintf("Dual Variables (Shadow Prices): y1 = %.4f, y2 = %.4f, y3 = %.4f\n", y_values[1], y_values[2], y_values[3]))
} else {
cat(sprintf("GLPK Interior-Point solver failed with status: %d\n", solve_status))
}
# --- Clean up the problem object ---
delProbGLPK(lp)
# --- Solve the problem using the Interior-Point Method ---
solve_status <- solveInteriorGLPK(lp)
# --- Solve the problem using the Interior-Point Method ---
solve_status <- solveInteriorGLPK(lp)
