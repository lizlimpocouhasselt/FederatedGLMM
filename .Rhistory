library(lme4)
set.seed(123)
## Simulate data
n <- 100
group <- factor(rep(1:20, each = 5))
x <- rnorm(n)
b <- rnorm(20, sd = 1)              # random intercepts
sigma <- 0.5                        # residual SD
w <- runif(n, 0.5, 2)               # arbitrary observation weights
y <- 2 + 3*x + b[group] + rnorm(n, sd = sigma / sqrt(w))
dat <- data.frame(y, x, group, w)
## --- FIT 1: Using built-in weights argument -------------------------------
fit_w <- lmer(y ~ x + (1 | group), weights = w, data = dat)
## --- FIT 2: Equivalent model with transformed data -------------------------
sqrtw <- sqrt(dat$w)
dat$y_star <- sqrtw * dat$y
dat$x_star <- sqrtw * dat$x
## IMPORTANT: random-effects design must also be weighted
## We achieve this by supplying the weighted response and weighted X,
## and letting lmer build Z* = sqrt(w) Z internally.
fit_star <- lmer(y_star ~ x_star + (1 | group), data = dat)
## --- Compare results -------------------------------------------------------
summary(fit_w)$coefficients
summary(fit_star)$coefficients
VarCorr(fit_w)
VarCorr(fit_star)
summary(fit_w)
summary(fit_star)
coef(fit_w)$group[1:5,]
coef(fit_star)$group[1:5,]
summary(fit_w)$varcor
summary(fit_star)$varcor
# Run this in R
library(lme4)
set.seed(123)
# Simulate base (one row per unique x)
m <- 30                       # unique rows
group <- factor(rep(1:6, length.out = m))
x <- rnorm(m)
b <- rnorm(6, sd = 1)
sigma <- 0.4
# true data for each unique row
y_base <- 1 + 2*x + b[group] + rnorm(m, sd = sigma)
# frequency weights (integers)
freq <- sample(1:8, m, replace = TRUE)   # integer counts
# create 'aggregated' data (one row per unique x with freq)
dat_agg <- data.frame(y = y_base, x = x, group = group, w = freq)
# 1) Expand: literal replication according to freq
dat_expanded <- dat_agg[rep(1:nrow(dat_agg), dat_agg$w), ]
# note: random-effect grouping remains correct via 'group' column
fit_expanded <- lmer(y ~ x + (1 | group), data = dat_expanded)
# 2) Use lmer weights = freq (WLS style)
fit_weighted <- lmer(y ~ x + (1 | group), weights = w, data = dat_agg)
# 3) Equivalent sqrt(w) transform (explicit transform)
sqrtw <- sqrt(dat_agg$w)
dat_agg$y_star <- sqrtw * dat_agg$y
dat_agg$x_star <- sqrtw * dat_agg$x
# we also implicitly transform Z by weighting rows (formula does that)
fit_sqrt <- lmer(y_star ~ x_star + (1 | group), data = dat_agg)
# Compare fixed effects and variance components
cat("\nFixed effects (expanded):\n"); print(fixef(fit_expanded))
cat("\nFixed effects (weights):\n"); print(fixef(fit_weighted))
cat("\nFixed effects (sqrt transform):\n"); print(fixef(fit_sqrt))
cat("\n\nVariance components (expanded):\n"); print(VarCorr(fit_expanded))
cat("\nVariance components (weights):\n"); print(VarCorr(fit_weighted))
cat("\nVariance components (sqrt transform):\n"); print(VarCorr(fit_sqrt))
# Numeric differences
cat("\n\nDifferences between expanded and weighted (fixed effects):\n")
print(fixef(fit_expanded) - fixef(fit_weighted))
cat("\nDifferences between expanded and sqrt-transformed (fixed effects):\n")
print(fixef(fit_expanded) - fixef(fit_sqrt))
